USE db_capex;

SELECT
    p.nome_projeto,
    f.id_projeto,
    f.valor_budget,
    f.valor_real,
    f.valor_compromisso,

    CAST(
        f.valor_real / f.valor_budget * 100
        AS DECIMAL(10,2)
    ) AS percentual_execucao,

    f.valor_budget - f.valor_real AS saldo_budget,

    f.valor_real
        + f.valor_compromisso
        + f.valor_provisao AS exposicao_financeira,

    CAST(
        (
            f.valor_real
            + f.valor_compromisso
            + f.valor_provisao
        ) / f.valor_budget * 100
        AS DECIMAL(10,2)
    ) AS percentual_exposicao,

    CASE
        WHEN
            (
                f.valor_real
                + f.valor_compromisso
                + f.valor_provisao
            ) / f.valor_budget * 100 > 100
        THEN 'Acima do orçamento'

        WHEN
            (
                f.valor_real
                + f.valor_compromisso
                + f.valor_provisao
            ) / f.valor_budget * 100 >= 95
        THEN 'Atenção'

        ELSE 'Dentro do orçamento'
    END AS status_exposicao

FROM tb_financeiro f

INNER JOIN tb_projetos p
    ON f.id_projeto = p.id_projeto

ORDER BY percentual_execucao DESC;
